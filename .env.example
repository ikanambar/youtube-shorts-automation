# ============================================
# YouTube Shorts Automation - Environment Config
# ============================================

# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-change-this
FLASK_ENV=development
FLASK_DEBUG=True

# Database
DATABASE_URL=sqlite:///database/app.db

# YouTube API (Get from Google Cloud Console - FREE)
# https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your-google-client-id
YOUTUBE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/auth/youtube/callback

# Pexels API (FREE - https://www.pexels.com/api/)
PEXELS_API_KEY=your-pexels-api-key

# Pixabay API (FREE - https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your-pixabay-api-key

# OpenAI API (OPTIONAL - for AI script generation)
# Leave empty to use template-based generation (FREE)
OPENAI_API_KEY=

# Edge TTS Voice (FREE - No API key needed)
# Options: id-ID-ArdiNeural, id-ID-GadisNeural, en-US-ChristopherNeural, en-US-JennyNeural
TTS_VOICE=id-ID-ArdiNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_DURATION_MIN=15
VIDEO_DURATION_MAX=60

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_SCHEDULED_VIDEOS=50

# Redis (for task queue - optional, uses threading if not available)
REDIS_URL=redis://localhost:6379/0
